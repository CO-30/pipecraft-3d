{
  "name": "pipecraft-3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test -c playwright.pwa.config.ts",
    "bench": "node -e \"process.env.BENCH_DIR=require('path').resolve(process.argv[1]||'bench-data');require('child_process').execSync('npx vitest run src/bench/local.bench.test.ts',{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "dexie": "4.4.7",
    "exceljs": "4.4.0",
    "ezjww": "0.7.11",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "polyclip-ts": "0.16.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "fake-indexeddb": "6.2.7",
    "jsdom": "31.0.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
